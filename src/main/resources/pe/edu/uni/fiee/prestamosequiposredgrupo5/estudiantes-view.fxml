<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.uni.fiee.prestamosequiposredgrupo5.usuarios.EstudiantesController"
      alignment="CENTER"
      spacing="15"
      prefWidth="500"
      prefHeight="600">

    <padding>
        <Insets top="25" right="30"
                bottom="25" left="30"/>
    </padding>

    <Label text="GESTIÓN DE ESTUDIANTES"
           style="-fx-font-size: 20px;
                  -fx-font-weight: bold;"/>

    <Label text="Registro y búsqueda de estudiantes"/>

    <TextField fx:id="campoCodigo"
               promptText="Código universitario"
               maxWidth="320"/>

    <TextField fx:id="campoNombres"
               promptText="Nombres"
               maxWidth="320"/>

    <TextField fx:id="campoApellidos"
               promptText="Apellidos"
               maxWidth="320"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Registrar"
                onAction="#registrar"
                prefWidth="155"/>

        <Button text="Buscar"
                onAction="#buscar"
                prefWidth="155"/>
    </HBox>

    <Label fx:id="mensajeEstado"
           wrapText="true"
           maxWidth="320"/>

    <Label text="ESTUDIANTES REGISTRADOS"
           style="-fx-font-size: 14px;
              -fx-font-weight: bold;"/>

    <TableView fx:id="tablaEstudiantes"
               prefHeight="180"
               maxWidth="440">

        <columns>
            <TableColumn fx:id="columnaCodigo"
                         text="Código universitario"
                         prefWidth="150"/>

            <TableColumn fx:id="columnaNombres"
                         text="Nombres"
                         prefWidth="140"/>

            <TableColumn fx:id="columnaApellidos"
                         text="Apellidos"
                         prefWidth="145"/>
        </columns>

    </TableView>

</VBox>
