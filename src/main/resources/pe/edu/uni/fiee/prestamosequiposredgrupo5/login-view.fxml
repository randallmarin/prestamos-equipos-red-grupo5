<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      fx:controller="pe.edu.uni.fiee.prestamosequiposredgrupo5.usuarios.LoginController"
      xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER"
      spacing="15"
      prefWidth="420"
      prefHeight="350">

    <padding>
        <Insets top="25" right="30"
                bottom="25" left="30"/>
    </padding>

    <Label text="PRÉSTAMO DE EQUIPOS DE RED"
           style="-fx-font-size: 18px;
                  -fx-font-weight: bold;"/>

    <Label text="Inicio de sesión"
           style="-fx-font-size: 15px;"/>

    <TextField fx:id="campoUsuario"
               promptText="Ingrese su usuario"
               maxWidth="280"/>

    <PasswordField fx:id="campoContrasena"
                   promptText="Ingrese su contraseña"
                   maxWidth="280"/>


    <Button text="Ingresar"
            onAction="#ingresar"
            prefWidth="280"/>


    <Label fx:id="mensajeEstado"
           text=""/>

</VBox>
