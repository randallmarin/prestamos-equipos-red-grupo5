<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      spacing="15" prefWidth="1000" prefHeight="700"
      style="-fx-background-color: #f4f6f9;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- Encabezado -->

    <Label text="Devolución de equipos"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #20334d;"/>

    <Label text="Gestión de devoluciones de equipos de red del laboratorio"
           style="-fx-text-fill: #64748b;"/>

    <Separator/>

    <!-- Búsqueda de préstamos activos -->

    <Label text="Buscar préstamos activos"
           style="-fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">

        <TextField fx:id="txtBuscar"
                   promptText="Código de préstamo, estudiante o equipo"
                   HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnBuscar"
                text="Buscar"
                style="-fx-background-color: #245a91;
                       -fx-text-fill: white;"/>

        <Button fx:id="btnLimpiar"
                text="Limpiar"/>

    </HBox>

    <!-- Tabla de préstamos activos -->

    <TableView fx:id="tablaPrestamos"
               prefHeight="240"
               VBox.vgrow="ALWAYS">

        <placeholder>
            <Label text="No hay préstamos activos para mostrar"/>
        </placeholder>

        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>

        <columns>

            <TableColumn fx:id="colCodigo"
                         text="Préstamo"
                         prefWidth="100"/>

            <TableColumn fx:id="colEstudiante"
                         text="Estudiante"
                         prefWidth="180"/>

            <TableColumn fx:id="colEquipo"
                         text="Equipo"
                         prefWidth="160"/>

            <TableColumn fx:id="colFecha"
                         text="Fecha de préstamo"
                         prefWidth="150"/>

            <TableColumn fx:id="colFechaPrevista"
                         text="Devolución prevista"
                         prefWidth="150"/>

            <TableColumn fx:id="colEstado"
                         text="Estado"
                         prefWidth="100"/>

        </columns>

    </TableView>

    <Label fx:id="lblPrestamoSeleccionado"
           text="Seleccione un préstamo de la tabla."
           style="-fx-text-fill: #64748b;"/>

    <Separator/>

    <!-- Datos de devolución -->

    <Label text="Datos de devolución"
           style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #20334d;"/>

    <HBox spacing="25">

        <VBox spacing="8" HBox.hgrow="ALWAYS">

            <Label text="Fecha real de devolución"/>

            <DatePicker fx:id="dpFechaDevolucion"
                        promptText="Seleccione la fecha"
                        maxWidth="Infinity"/>

        </VBox>

        <VBox spacing="8" HBox.hgrow="ALWAYS">

            <Label text="Condición física del equipo"/>

            <ComboBox fx:id="cmbCondicion"
                      promptText="Seleccione la condición"
                      maxWidth="Infinity">

                <items>

                    <FXCollections fx:factory="observableArrayList">

                        <String fx:value="Operativo"/>
                        <String fx:value="Dañado"/>
                        <String fx:value="En mantenimiento"/>

                    </FXCollections>

                </items>

            </ComboBox>

        </VBox>

    </HBox>

    <!-- Observaciones -->

    <Label text="Observaciones"/>

    <TextArea fx:id="txtObservaciones"
              promptText="Describa la condición física del equipo recibido..."
              prefHeight="100"
              wrapText="true"/>

    <Separator/>

    <!-- Botones de operación -->

    <HBox spacing="12" alignment="CENTER_RIGHT">

        <Button fx:id="btnCancelar"
                text="Cancelar"
                prefWidth="110"/>

        <Button fx:id="btnRegistrar"
                text="Registrar devolución"
                prefWidth="180"
                style="-fx-background-color: #245a91;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

    </HBox>

</VBox>
